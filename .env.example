# ─────────────────────────────────────────────────────────────
# Mentor AI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# AWS credentials (leave both blank to use offline/fallback mode)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# auto detects AWS credential providers; set true to force offline mode
BEDROCK_OFFLINE=auto

# Bedrock model ID
# Example: anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Server settings
HOST=0.0.0.0
PORT=8000

# CORS — set to your website origin in production, * for dev
CORS_ORIGIN=*

# Rate limiter (requests per window per IP)
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
# Set true only when a trusted proxy sanitizes X-Forwarded-For
TRUST_PROXY_HEADERS=false
# Maximum accepted question length
MAX_QUESTION_LENGTH=2000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
